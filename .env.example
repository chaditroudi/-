# ── Date Harvest Hub v2 — copy to .env and fill secrets ─────────────────────
# Never commit real .env files. See docs/BUYER_HANDOFF.md

# Local Mongo
# # What this server is: production, staging, live-dev, dev or test.
# dev and test refuse a remote database. Demo data only goes to dev, test or an unlabelled
# local database. An unlabelled server on a remote database starts, with a warning.
# APP_ENV=dev

MONGODB_URI=mongodb://127.0.0.1:27017/date_harvest_hub

# Atlas (recommended for demos / production)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=date_harvest_hub

# REQUIRED in production — long random string
JWT_SECRET=replace-with-a-long-random-secret

# First admin, created once on an empty database, then forced to change password.
# Gate 3 requires explicit company/site membership on every account.
INITIAL_ADMIN_EMAIL=admin@gmail.com
INITIAL_ADMIN_PASSWORD=chadi1A&chadi1A&
INITIAL_ADMIN_TENANT_ID=demo-company
INITIAL_ADMIN_FACTORY_ID=demo-site

# Optional overrides for npm run seed:actors (defaults to INITIAL_ADMIN_* / local demo-*).
# TEST_ACTOR_PASSWORD=Test123!
# TEST_ACTOR_TENANT_ID=demo-company
# TEST_ACTOR_FACTORY_ID=demo-site

# Exact browser origins allowed to call the API, comma separated.
CORS_ORIGINS=

# QC release signature. Unset means enforced, and production always enforces, so
# every quality user needs a PIN (scripts/audit-pin-readiness.mjs lists who lacks one).
# Other signatures still default to warn. Outside production, weaken explicitly only:
# NUMERIC_SIGNATURE_GATE=warn

# Local simulators only. Production never accepts simulator devices.
# WEIGHBRIDGE_SIMULATOR_SECRET=
# CCP_SIMULATOR_SECRET=

PORT=4000
API_HOST=0.0.0.0
DATABASE_RETRY_INTERVAL_MS=60000
VITE_API_URL=/api

# ── TODO LATER (ops) — real SMTP for supplier BC emails ─────────────────────
# Come back: fill these in production .env per manufacturer instance.
# Until then, without SMTP emails log to the server console (safe local demo).
#
# SMTP_HOST=...
# SMTP_PORT=587
# SMTP_FROM="Achats <achats@votre-usine.tn>"
# SMTP_USER=...
# SMTP_PASS=...
# APP_PUBLIC_URL=https://mes.votre-usine.tn
#
# Optional:
# SMTP_SECURE=false
# MAIL_FROM=achats@votre-usine.tn
# MAIL_CONSOLE_FALLBACK=true
# Branding (company/plant/colors) = Settings usine, not these vars.

# Wave B/C trust gates: off | warn | enforce
# Start with warn for go-live; switch to enforce after a clean shift (no LOT_LEDGER_STAGE_FAILED).
# TRUST_MASS_BALANCE_GATE=warn
# TRUST_SCAN_GATE=warn
# TRUST_CCP_GATE=warn
# TRUST_STAGE_GATE=warn
# TRUST_MASS_BALANCE_TOLERANCE_PCT=2

# After a clean warn-mode shift (zero LOT_LEDGER_STAGE_FAILED):
# TRUST_SCAN_GATE=enforce
# TRUST_CCP_GATE=enforce
# TRUST_STAGE_GATE=enforce
# TRUST_MASS_BALANCE_GATE=enforce

# AI Employee Guide — explanation layer only. Never mutates stock/QC.
# Code default is off. For a local Ollama plant (qwen2.5:7b on this machine):
# AI_GUIDE_ENABLED=true
# AI_GUIDE_PROVIDER=ollama
# AI_GUIDE_MODEL=qwen2.5:7b
# AI_GUIDE_BASE_URL=http://127.0.0.1:11434
# AI_GUIDE_MAX_OUTPUT_TOKENS=160
# AI_GUIDE_TIMEOUT_MS=20000
# AI_GUIDE_MAX_CONTEXT_CHARS=2000
# AI_GUIDE_MAX_HISTORY_MESSAGES=4
# AI_GUIDE_MAX_PROCEDURE_CHARS=900
# AI_GUIDE_DEFAULT_LANGUAGE=fr

# GS1 company prefix for SSCC (7–10 digits). Placeholder 09999999 is NOT retail-legal.
# Prefer Settings → Documents → gs1_company_prefix once assigned by GS1 Tunisia.
# GS1_COMPANY_PREFIX=09999999
